                "flex-direction": "row-reverse"
              }
            },
            ".mbr-text": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-section-subtitle": {
              "color": "#000000",
              "text-align": "left"
            },
            ".mbr-section-title": {
              "text-align": "center",
              "color": "#000000"
            },
            ".mbr-card-title": {
              "color": "#000000",
              "text-align": "left"
            },
            ".mbr-card-subtitle": {
              "color": "#000000",
              "text-align": "left"
